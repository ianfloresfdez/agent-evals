<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>agent-evals report</title>
<style>
:root {
  --bg: #f7f7f5; --card: #ffffff; --ink: #1c1d1f; --muted: #6b6f76; --line: #e3e3df;
  --ok: #1f7a4d; --ok-bg: #e6f4ec; --bad: #b4332f; --bad-bg: #fbeaea; --accent: #3b5bdb; --code: #f1f1ee;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #141518; --card: #1c1e22; --ink: #e8e8e6; --muted: #9a9ea6; --line: #2c2f35;
    --ok: #5cc28e; --ok-bg: #18301f; --bad: #f08a84; --bad-bg: #3a1c1b; --accent: #8ea6ff; --code: #24272c; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1120px; margin: 0 auto; padding: 32px 16px 64px; }
h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
h2 { font-size: 18px; margin: 0; }
.sub { color: var(--muted); margin: 0 0 28px; }
section.suite { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 20px; margin-bottom: 28px; }
.head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; align-items: baseline; margin-bottom: 4px; }
.meta { color: var(--muted); font-size: 12.5px; }
.meta code { background: var(--code); padding: 1px 5px; border-radius: 4px; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin: 16px 0; }
.kpi { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
.kpi .v { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
.kpi .l { color: var(--muted); font-size: 12px; }
.kpi svg { display: block; margin-top: 4px; }
.gate { display: inline-block; font-weight: 600; font-size: 12px; padding: 2px 8px; border-radius: 99px; }
.gate.ok, .pill.ok { color: var(--ok); background: var(--ok-bg); }
.gate.bad, .pill.bad { color: var(--bad); background: var(--bad-bg); }
.cmp { font-size: 12.5px; color: var(--muted); margin: 0 0 14px; }
.cmp b.bad { color: var(--bad); }
table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
th { text-align: left; font-weight: 500; color: var(--muted); font-size: 12px; border-bottom: 1px solid var(--line); padding: 6px 8px; }
td { border-bottom: 1px solid var(--line); padding: 7px 8px; vertical-align: top; }
td.num, th.num { text-align: right; white-space: nowrap; }
.pill { font-size: 11.5px; font-weight: 600; padding: 1px 7px; border-radius: 99px; }
details summary { cursor: pointer; color: var(--accent); font-size: 12.5px; }
.detail { margin: 8px 0 4px; display: grid; gap: 8px; }
.detail ul { margin: 0; padding-left: 18px; }
.detail li.f { color: var(--bad); }
.detail pre { background: var(--code); padding: 8px 10px; border-radius: 6px; white-space: pre-wrap; word-break: break-word; max-height: 260px; overflow: auto; margin: 0; font-size: 12px; }
.tbl { overflow-x: auto; }
.tag { font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; margin-right: 3px; }
.empty { color: var(--muted); }
</style>
</head>
<body>
<main>
<h1>agent-evals</h1>
<p class="sub">Latest run of each golden set, with its trend and a regression check against the previous run.</p>
{% if not suites %}<p class="empty">No results yet. Run <code>agent-evals run &lt;suite.yaml&gt;</code> first.</p>{% endif %}
{% for s in suites %}{% set r = s.run %}{% set m = r.summary %}
<section class="suite">
  <div class="head">
    <h2>{{ r.suite }} <span class="meta">v{{ r.suite_version }} · {{ r.suite_sha256 }}</span></h2>
    {% if s.cmp %}<span class="gate {{ 'ok' if s.cmp.ok else 'bad' }}">regression gate {{ 'PASS' if s.cmp.ok else 'FAIL' }}</span>{% endif %}
  </div>
  <div class="meta">
    target <code>{{ r.target.type }}</code>{% if r.target.model %} · model <code>{{ r.target.model }}</code>{% endif %}{% if r.target.agent_mode %} · agent mode <code>{{ r.target.agent_mode }}</code>{% endif %}{% if r.target.repo_sha %} · {{ r.target.repo }}@<code>{{ r.target.repo_sha }}</code>{% endif %}
    · judge <code>{{ r.judge or 'off' }}</code> · run {{ r.started_at }} · {{ r.duration_s }} s · {{ s.history|length }} run(s) in history
  </div>
  <div class="kpis">
    <div class="kpi"><div class="v">{{ m.passed }}/{{ m.cases }}</div><div class="l">cases passed ({{ m.pass_rate|pct }})</div>
      {% if s.spark_pass %}<svg width="120" height="28" aria-label="pass rate trend"><polyline points="{{ s.spark_pass }}" fill="none" stroke="var(--accent)" stroke-width="1.5"/></svg>{% endif %}</div>
    <div class="kpi"><div class="v">{{ m.task_success_rate|pct }}</div><div class="l">task success (deterministic)</div></div>
    {% if m.repeats > 1 %}<div class="kpi"><div class="v">{{ m.attempt_pass_rate|pct }}</div><div class="l">of {{ m.repeats }}×{{ m.cases }} attempts passed · {{ m.flaky_cases|length }} flaky</div></div>{% endif %}
    {% if m.tool_recall_mean is not none %}<div class="kpi"><div class="v">{{ m.tool_recall_mean|pct }} / {{ m.tool_precision_mean|pct }}</div><div class="l">tool recall / precision</div></div>{% endif %}
    {% if m.judge_mean is not none %}<div class="kpi"><div class="v">{{ '%.2f'|format(m.judge_mean) }}<span class="meta"> /5</span></div><div class="l">LLM judge mean</div></div>{% endif %}
    <div class="kpi"><div class="v">{{ m.latency_p50_ms|ms }}</div><div class="l">latency p50 · p95 {{ m.latency_p95_ms|ms }}</div>
      {% if s.spark_latency %}<svg width="120" height="28" aria-label="latency trend"><polyline points="{{ s.spark_latency }}" fill="none" stroke="var(--muted)" stroke-width="1.5"/></svg>{% endif %}</div>
    <div class="kpi"><div class="v">{{ '{:,}'.format(m.tokens_total) }}</div><div class="l">agent tokens ({{ '%.0f'|format(m.tokens_mean) }}/{{ 'attempt' if m.repeats > 1 else 'case' }})</div></div>
    <div class="kpi"><div class="v">${{ '%.4f'|format(m.cost_usd_total) }}</div><div class="l">cost{% if m.judge_tokens_total %} · judge {{ '{:,}'.format(m.judge_tokens_total) }} tok{% endif %}</div></div>
  </div>
  {% if s.cmp %}<p class="cmp">vs {{ s.cmp.baseline_id }}:
    {% for f in s.cmp.findings %}{% if f.metric != 'cases' %}{{ f.metric }} {% if f.ok %}{{ '%g'|format(f.baseline) }}→{{ '%g'|format(f.current) }}{% else %}<b class="bad">{{ '%g'|format(f.baseline) }}→{{ '%g'|format(f.current) }}</b>{% endif %}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
    {% if s.cmp.regressed_cases %} · <b class="bad">regressed: {{ s.cmp.regressed_cases|join(', ') }}</b>{% endif %}
    {% if s.cmp.suite_changed %} · golden set changed{% endif %}</p>{% endif %}
  <div class="tbl"><table>
    {% if m.repeats > 1 %}<p class="cmp">Each case ran {{ m.repeats }} times; a case passes only if every attempt passed. Details below show the first attempt.</p>{% endif %}
    <thead><tr><th>case</th><th>result</th><th class="num">checks</th><th class="num">tools</th><th class="num">judge</th><th class="num">latency</th><th class="num">tokens</th></tr></thead>
    <tbody>
    {% for c in r.cases %}{% set ok = c.checks|selectattr('passed')|list|length %}
    <tr>
      <td><b>{{ c.id }}</b><br>{% for t in c.tags %}<span class="tag">{{ t }}</span>{% endfor %}
        <details><summary>details</summary><div class="detail">
          <ul>{% for k in c.checks %}<li class="{{ '' if k.passed else 'f' }}">{{ '✔' if k.passed else '✖' }} {{ k.name }}{% if k.detail %} — {{ k.detail }}{% endif %}</li>{% endfor %}</ul>
          {% if c.attempts %}<pre>{% for a in c.attempts %}#{{ loop.index }} {{ 'pass' if a.passed else 'FAIL' }} · {{ a.latency_ms|ms }} · {{ a.tokens }} tok · judge {{ a.judge_score if a.judge_score is not none else '—' }} · {{ a.tool_calls|join(' → ') or 'no tools' }}{% if a.failed_checks %} · ✖ {{ a.failed_checks|join('; ') }}{% endif %}
{% endfor %}</pre>{% endif %}
          {% if c.trace.tool_calls %}<pre>{% for t in c.trace.tool_calls %}{{ t.name }}({{ t.args|tojson }}){{ '' if t.ok else '  ✖ error' }}
{% endfor %}</pre>{% endif %}
          {% if c.judge %}<pre>judge {{ c.judge.model }}: {{ c.judge.score if c.judge.score is not none else 'n/a' }}/5 — {{ c.judge.reasoning or c.judge.error }}</pre>{% endif %}
          {% if c.trace.error %}<pre>error: {{ c.trace.error }}</pre>{% endif %}
          <pre>{{ c.trace.output[:3000] }}</pre>
        </div></details></td>
      <td><span class="pill {{ 'ok' if c.passed else 'bad' }}">{{ 'pass' if c.passed else ('flaky' if c.flaky else 'fail') }}</span>{% if c.attempts %}<br><span class="meta">{{ c.attempts_passed }}/{{ c.attempts|length }} attempts</span>{% endif %}</td>
      <td class="num">{{ ok }}/{{ c.checks|length }}</td>
      <td class="num">{% if c.tool_recall is not none %}{{ c.tool_recall|pct }} · {{ c.tool_precision|pct }}{% else %}{{ c.trace.tool_calls|length }} calls{% endif %}</td>
      <td class="num">{{ '%g'|format(c.judge.score) if c.judge and c.judge.score is not none else '—' }}</td>
      <td class="num">{{ c.trace.latency_ms|ms }}</td>
      <td class="num">{{ '{:,}'.format(c.trace.usage.input_tokens + c.trace.usage.output_tokens) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% endfor %}
</main>
</body>
</html>
